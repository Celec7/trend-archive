ort_link_v2": "https://b23.tv/BV1G48M6XEBt", "first_frame": "http://i2.hdslb.com/bfs/storyff/_00003lccjeag1eft82p2reneew5xbeb_firsti.jpg", "pub_location": "湖南", "cover43": "http://i2.hdslb.com/bfs/archive/e97fc99a087e3c943587f4f8b0699f90c26d894b.jpg", "tidv2": 2071, "tnamev2": "射击游戏", "pid_v2": 1008, "pid_name_v2": "游戏", "attribute_v3": 4, "bvid": "BV1G48M6XEBt", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"content": "百万播放", "corner_mark": 1}}, {"aid": 117145300113149, "videos": 1, "tid": 201, "tname": "科学科普", "copyright": 3, "pic": "http://i0.hdslb.com/bfs/archive/aafe81ff3fa1cd75ebe0e943cfcff2f4f8f18494.jpg", "title": "特大暴雨来了：三台风几乎都已锁定我国，超强台风沙德尔走位古怪", "pubdate": 1787495949, "ctime": 1787495949, "desc": "19号台风紫檀已经给我国广西、越南带去特大暴雨。截至8月23日，防城港局部最大72小时累积雨量已达700毫米以上，越南最大累积雨量1000毫米左右，南宁、广东湛江等也出现短时暴雨，这是台风美莎克以来广西的最强暴雨。而20号台风简拉维带来了多种天气：在江浙沪、安徽和江西东部、福建、广东东部，是散装暴雨和热带蓝、积云交替的天气；而在台湾西南部，它也带来了大暴雨到特大暴雨。\n这是因为，简拉维实在太弱且结构实在混乱。8月23日它的北侧中心登陆浙江台州附近后，迅速被副高下沉气流拍死，连雨也没下多少，该怎么热还是怎么", "state": 0, "duration": 193, "mission_id": 4067021, "rights": {"bp": 0, "elec": 0, "download": 0, "movie": 0, "pay": 0, "hd5": 0, "no_reprint": 0, "autoplay": 1, "ugc_pay": 0, "is_cooperation": 0, "ugc_pay_preview": 0, "no_background": 0, "arc_pay": 0, "pay_free_watch": 0}, "owner": {"mid": 547072854, "name": "中气爱", "face": "https://i0.hdslb.com/bfs/face/e5f6be30a18988ed92f677e6a47a346270172081.jpg"}, "stat": {"aid": 117145300113149, "view": 532466, "danmaku": 1131, "reply": 2608, "favorite": 1661, "coin": 829, "share": 2131, "now_rank": 0, "his_rank": 0, "like": 22684, "dislike": 0, "vt": 0, "vv": 532466, "fav_g": 0, "like_g": 0}, "dynamic": "", "cid": 41195668555, "dimension": {"width": 1920, "height": 1080, "rotate": 0}, "short_link_v2": "https://b23.tv/BV1rM8h6AERG", "first_frame": "http://i0.hdslb.com/bfs/storyff/_000020t37q6uumvuq2ckwjaxdv6h34b_firsti.jpg", "pub_location": "江苏", "cover43": "http://i2.hdslb.com/bfs/archive/b2a2201ce7f26703bdba23d00a