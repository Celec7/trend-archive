7": {"data": {"tag_id": 81867, "tag_name": "韩国电影", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "5251": {"data": {"tag_id": 5251, "tag_name": "科幻", "cover": "http://i0.hdslb.com/bfs/archive/1e864e3ab3c0c73728c03fb6e900121096ab5cd9.jpg", "head_cover": "http://i0.hdslb.com/bfs/archive/01f91876cc434f70d39f650ddb28517f7b82fed5.jpg", "content": "未来是什么样的？", "short_content": "科学与幻想的未来间距", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "15402": {"data": {"tag_id": 15402, "tag_name": "人性", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "841": {"data": {"tag_id": 841, "tag_name": "恐怖", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "5741": {"data": {"tag_id": 5741, "tag_name": "丧尸", "cover": "http://i0.hdslb.com/bfs/tag/4b608a6950305641d21a1ad9f180da61067666c5.jpg", "head_cover": "", "content": "丧尸（英文：Zombie）也有活尸、活死人的说法，是传说中形如死人而能够活动的怪物，来自非洲的巫毒教信仰，在现代的文艺作品中也有出现。丧尸类似吸血鬼或僵尸，属于不死生物。 近年，流行文化中一般使用“丧尸”作为Zombie的中文名称，但有时Zombie也译作僵尸", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "105669": {"data": {"tag_id": 105669, "tag_name": "全智贤", "cover": "http://i0.hdslb.com/bfs/tag/55632ffd9bdd9a0510d1bf8dbc005ec7fe433d6e.jpg", "head_cover": "", "content": "全智贤，1981年10月30日出生于首尔，韩国女演员。1997年从事模特行业出道。1999年主演电影《白色情人节》获得百想艺术大赏电影部门最佳女新人奖。2000年主演文艺爱情电影《触不到的恋人》获得各界好评，并被好莱坞翻拍。2001年凭借电影《我的野蛮女友》在亚洲甚至世界范围掀起了一阵“野蛮风潮”，获得韩国电影大钟奖最佳女主角奖。其后相继主演《野蛮师姐》、《雏菊》、《雪花秘扇》等多部电影。2012年主演电影《盗贼同盟》 ，刷新了韩国电影的最高票房纪录。2013年主演口碑票房双收的电影《柏林》，获得了富川国际奇幻电影节制片人选择奖。2013年底时隔14年重返电视剧场主演了风靡亚洲的《来自星星的你》，夺得第50届百想艺术大赏TV部门大赏。 同年获得韩国观光部门颁发的“韩国观光旅游之星”，并被委任为韩国旅游荣誉宣传大使 。资料来自百度百科。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "478530": {"data": {"tag_id": 478530, "tag_name": "群体", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "14002": {"data": {"tag_id": 14002, "tag_name": "惊悚片", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "2624777": {"data": {"tag_id": 2624777, "tag_name": "延尚昊", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1473847400, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "95802493": {"data": {"tag_id": 95802493, "tag_name": "恐怖片十级学者", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1780564199, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "3238": {"data": {"tag_id": 3238, "tag_name": "GTA", "cover": "http://i0.hdslb.com/bfs/tag/9a63c726856d98496e0e86df1d3096f5295f22f8.jpg", "head_cover": "", "content": "《侠盗猎车手》（Grand Theft Auto，简称 GTA，又译《横行霸道》、《侠盗猎车》、《侠盗飞车》、《侠盗车手》）是一系列以犯罪为主题的动作游戏，由 Rockstar North负责开发，Rockstar Games 发行。在游戏中，玩家扮演城市中的犯罪角色，透过完成一连串有组织罪案的任务来提升自己的威势，任务通常为枪战、抢银行、行刺等，其他犯罪以外的任务则有驾驶出租车、救火、赛车、飞行等。侠盗猎车手也因给玩家在游戏内随心所欲、自由度高而知名，它不像传统的动作游戏般只有单向式的历程，但在侠盗猎车手中，玩家可随意选择先玩的任务", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "74373": {"data": {"tag_id": 74373, "tag_name": "游戏杂谈", "cover": "http://i0.hdslb.com/bfs/tag/6057e57134c1f2e7960cb7daa18aa350e6721dc0.png", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "802": {"data": {"tag_id": 802, "tag_name": "游戏", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "171735": {"data": {"tag_id": 171735, "tag_name": "新游", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "257974": {"data": {"tag_id": 257974, "tag_name": "手游", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, 