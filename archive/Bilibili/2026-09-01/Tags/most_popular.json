{"857": {"data": {"tag_id": 857, "tag_name": "短片", "cover": "http://i0.hdslb.com/bfs/archive/47e02cc6dc38d64a1ab1ff106fab280e498ea71a.jpg", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 2}, "536": {"data": {"tag_id": 536, "tag_name": "原创", "cover": "", "head_cover": "", "content": "1", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 4}, "7544": {"data": {"tag_id": 7544, "tag_name": "西游记", "cover": "http://i0.hdslb.com/bfs/tag/48f64f2ce2b31567ca826a709b234e32c944b71e.jpg", "head_cover": "", "content": "《西游记》，又名《西游释厄传》，是一部中国古典神魔小说，为中国“四大名著”之一。书中讲述唐朝玄奘法师西天取经的故事，表现了惩恶扬善的古老主题。《西游记》成书于16世纪明朝中叶，自问世以来在中国及世界各地广为流传，被翻译成多种语言。在中国，乃至亚洲部分地区西游记家喻户晓，其中孙悟空、唐僧、猪八戒、沙僧等人物和《大闹天宫》、《三打白骨精》、《火焰山》等故事尤其为人熟悉。几百年来，西游记被改编成各种地方戏曲、电影、电视剧、动画片、漫画等，版本繁多。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "9013": {"data": {"tag_id": 9013, "tag_name": "神话", "cover": "http://i0.hdslb.com/bfs/tag/9c0601ec0e4cac193b0ce58f8e986fe6f0bde42e.jpg", "head_cover": "", "content": "2010年，时尚青年易小川（胡歌饰演）来到父亲易教授的考古发掘现场，却意外卷入一起抢夺文物的事件。机缘巧合之下，他误打开了一个神秘的古代宝盒，与考古队的厨师高要一起穿越时空，回到了2200多年前的秦朝。在一次次的奇遇和历险之中，易小川经历了刻骨铭心的爱情，结交了忠肝义胆的朋友，蜕变成了仁心济世的蒙毅；而原本胆小怕事的高要，在经受了一连串致命打击后心性逆转，充满仇恨的心灵在权利的诱惑下变得贪婪冷酷，不择手段。2010年，哥哥易大川（任泉饰演）与父母一直没有放弃找到弟弟易小川的希望，他们一边对抗神秘势力的阻扰破坏，一边破解着一个个与易小川失踪有关的谜团。历险途中，易小川的父母解开了困扰他们多年的心结，易大川战胜了内心的胆怯，找到了自己的真爱。最后，他们打开了传说中的宝藏，找到了易小川的下落，全家人终得团聚，创下了令人感动的神话。可是小川心爱的玉漱公主却因长生药失效离他而去，小川对着电影版神话海报上的玉漱公主（金喜善饰）说：“你没有她漂亮！”对于易小川来说，这不仅仅是一个神话，还是一段真实。最后，小川孤独地走在街上，倾诉着对玉漱深沉的思念。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "15204": {"data": {"tag_id": 15204, "tag_name": "孙悟空", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "33013": {"data": {"tag_id": 33013, "tag_name": "黑色幽默", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "272810": {"data": {"tag_id": 272810, "tag_name": "脑洞", "cover": "", "head_cover": "", "content": "1", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "35907664": {"data": {"tag_id": 35907664, "tag_name": "AI短片", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 1, "state": 0, "ctime": 1677190930, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "1159200": {"data": {"tag_id": 1159200, "tag_name": "西西弗斯", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "98496653": {"data": {"tag_id": 98496653, "tag_name": "SpecialForAAIFF", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "c